<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Review\Block\Adminhtml\Add\Form" type="Mirasvit\Review\Block\Adminhtml\Add\Form"/>

    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="mst_review_pending" xsi:type="string">Mirasvit\Review\Model\System\Message\PendingReviewMessage</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\AdminNotification\Ui\Component\DataProvider\DataProvider">
        <plugin name="mstReview:notification_type_plugin" type="Mirasvit\Review\Plugin\Backend\AdminNotification\PendingReviewNotificationTypePlugin" sortOrder="1"/>
    </type>
</config>
