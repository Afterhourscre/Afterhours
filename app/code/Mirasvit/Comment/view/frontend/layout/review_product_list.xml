<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <referenceBlock name="product_additional_data">
                <referenceBlock name="mst.product.review">
                    <block name="mst.product.review.comment" as="review.comment" class="Mirasvit\Comment\Block\Comment\Container" ifconfig="mst_comment/general/is_enabled" after="-"/>
                </referenceBlock>
            </referenceBlock>
        </referenceContainer>
    </body>
</page>
