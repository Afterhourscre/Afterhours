<?php
declare(strict_types=1);
/** @var \Mirasvit\Review\Block\Product\Review\Summary $block */

$reviewSummary = $block->getReviewSummary();
if (!$reviewSummary) {
    return '';
}
?>

<div class="item review-item review-summary">
    <div class="block-title title-summary">
        <strong><?= $block->escapeHtml(__('Reviews Summary')) ?></strong>
        <?php if ($block->isShowInfoHint()): ?>
        <span class="summary-info" title="<?= $block->escapeHtml(__('Summary generated by AI based on 10 latest reviews')) ?>">?</span>
        <?php endif; ?>

        <?php
        $ratingSummary = $reviewSummary->getRatingSummary();
        $reviewCount   = $reviewSummary->getReviewsCount();
        ?>
        <?php if ($ratingSummary): ?>
            <div class="product-reviews-summary short">
                <div class="rating-summary">
                    <div title="<?php echo (int)$ratingSummary; ?>%" class="rating-result">
                        <span style="width:<?php echo (int)$ratingSummary; ?>%"><span><?php echo (int)$ratingSummary; ?>%</span></span>
                    </div>
                </div>
                <div class="reviews-actions">
                    <?= '(' . $block->escapeHtml($reviewCount) . ')'; ?>
                </div>
            </div>
        <?php endif; ?>
    </div>

    <div class="review-content-container">
        <div class="review-content">
            <?= /* @noEscape */
            nl2br($block->escapeHtml($reviewSummary->getDetail())) ?>
        </div>
        <?= $block->getChildBlock('summary.proscons')->setReview($reviewSummary)->toHtml(); ?>
    </div>
    <div class="mask hidden"><span><?= $block->escapeHtml(__('Show more')) ?></span></div>
</div>
<script>
    require(['jquery'], function ($) {
        if ($('.review-summary .review-content').outerHeight() + $('.review-summary .review-additional').outerHeight() - $('.review-summary .review-content-container').outerHeight() >= 40) {
            $('.review-summary .mask').removeClass('hidden');
        }

        $('.mask span').on('click', function (e) {
            const toggler = $(e.target);

            $('.review-content-container', toggler.closest('.review-summary')).toggleClass('_opened');
            toggler.toggleClass('_opened');

            toggler.text(
                toggler.hasClass('_opened') ? '<?= $block->escapeHtml(__('Show less')) ?>' : '<?= $block->escapeHtml(__('Show more')) ?>'
            )
        });
    })
</script>
