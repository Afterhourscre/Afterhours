<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="mst_comment_pending" xsi:type="string">Mirasvit\Comment\Model\System\Message\PendingCommentMessage</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\AdminNotification\Ui\Component\DataProvider\DataProvider">
        <plugin name="mstComment:notification_type_plugin" type="Mirasvit\Comment\Plugin\Backend\AdminNotification\PendingCommentNotificationTypePlugin" sortOrder="1"/>
    </type>

    <type name="Mirasvit\BlogMx\Ui\Component\DataProvider">
        <plugin name="mst-comment-blog-mx-comment-count" type="Mirasvit\Comment\Plugin\Ui\BlogMx\AddCommentsCountDataToListingPlugin"/>
    </type>

    <type name="Mirasvit\Review\Ui\Review\Listing\DataProvider">
        <plugin name="mst-comment-review-comment-count" type="Mirasvit\Comment\Plugin\Ui\Review\AddCommentsCountDataToListingPlugin"/>
    </type>
</config>
