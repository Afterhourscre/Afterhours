<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction" component="Bss_ChatGPT/js/form-attributes">
            <action name="bss_generate_description_chatgpt">
                <settings>
                    <confirm>
                        <title translate="true">Generate description with AI</title>
                        <message translate="true">Are you sure you want to generate content of selected items?</message>
                    </confirm>
                    <type>generate-content-chatgpt</type>
                    <label translate="true">Generate Content with ChatGTP</label>
                    <actions>
                        <action name="0">
                            <type>short_description</type>
                            <label translate="true">Short description</label>
                            <url path="chatgpt/chatgpt/massaction">
                                <param name="short_description">1</param>
                            </url>
                        </action>
                        <action name="1">
                            <type>description</type>
                            <label translate="true">Description</label>
                            <url path="chatgpt/chatgpt/massaction">
                                <param name="description">1</param>
                            </url>
                        </action>
                        <action name="2">
                            <type>meta_title</type>
                            <label translate="true">Meta title</label>
                            <url path="chatgpt/chatgpt/massaction">
                                <param name="meta_title">1</param>
                            </url>
                        </action>
                        <action name="3">
                            <type>meta_keyword</type>
                            <label translate="true">Meta keywords</label>
                            <url path="chatgpt/chatgpt/massaction">
                                <param name="meta_keywords">1</param>
                            </url>
                        </action>
                        <action name="4">
                            <type>meta_description</type>
                            <label translate="true">Meta description</label>
                            <url path="chatgpt/chatgpt/massaction">
                                <param name="meta_description">1</param>
                            </url>
                        </action>
                    </actions>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
</listing>
