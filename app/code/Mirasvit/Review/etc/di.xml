<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Mirasvit\Review\Api\Data\ReviewInterface" type="Mirasvit\Review\Model\Review"/>
    <preference for="Mirasvit\Review\Api\Data\ReviewSummaryInterface" type="Mirasvit\Review\Model\ReviewSummary"/>
    <preference for="Mirasvit\Review\Api\Data\ReviewMediaInterface" type="Mirasvit\Review\Model\ReviewMedia"/>
    <preference for="Magento\Review\Ui\Component\Listing\Columns\ReviewActions" type="Mirasvit\Review\Ui\Component\Listing\Columns\ReviewActions"/>


    <!--UI-->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mst_review_listing_data_source" xsi:type="string">Mirasvit\Review\Model\ResourceModel\Review\Grid</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="AggregateCommand" xsi:type="object">Mirasvit\Review\Console\Command\AggregateCommand</item>
                <item name="ReindexCommand" xsi:type="object">Mirasvit\Review\Console\Command\ReindexCommand</item>
                <item name="GenerateCommand" xsi:type="object">Mirasvit\Review\Console\Command\GenerateCommand</item>
                <item name="NotifyPending" xsi:type="object">Mirasvit\Review\Console\Command\NotifyPendingCommand</item>
            </argument>
        </arguments>
    </type>

    <!--Entity Manager-->
    <type name="Magento\Framework\EntityManager\MetadataPool">
        <arguments>
            <argument name="metadata" xsi:type="array">
                <item name="Mirasvit\Review\Api\Data\ReviewInterface" xsi:type="array">
                    <item name="entityTableName" xsi:type="const">Mirasvit\Review\Api\Data\ReviewInterface::MAIN_TABLE</item>
                    <item name="identifierField" xsi:type="const">Mirasvit\Review\Api\Data\ReviewInterface::ID</item>
                </item>
                <item name="Mirasvit\Review\Api\Data\ReviewSummaryInterface" xsi:type="array">
                    <item name="entityTableName" xsi:type="const">Mirasvit\Review\Api\Data\ReviewSummaryInterface::TABLE_NAME</item>
                    <item name="identifierField" xsi:type="const">Mirasvit\Review\Api\Data\ReviewSummaryInterface::ID</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\EntityManager\HydratorPool">
        <arguments>
            <argument name="hydrators" xsi:type="array">
                <item name="Mirasvit\Review\Api\Data\ReviewSummaryInterface" xsi:type="string">Magento\Framework\EntityManager\AbstractModelHydrator</item>
            </argument>
        </arguments>
    </type>
</config>
