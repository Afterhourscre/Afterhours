<?xml version="1.0"?>

<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <referenceContainer name="content">
        <referenceBlock name="product.info.product_additional_data.wrapper">
            <referenceBlock name="mst.product.review">
                <block name="mst.product.review.comment" as="review.comment" class="Mirasvit\Comment\Block\Comment\Container" ifconfig="mst_comment/general/is_enabled" after="-"/>
            </referenceBlock>
        </referenceBlock>
    </referenceContainer>
</layout>
